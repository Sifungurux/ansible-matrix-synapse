# {{ ansible_managed }}
# Matrix Synapse homeserver configuration
# See https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html

server_name: "{{ synapse_server_name }}"
public_baseurl: "{{ synapse_public_baseurl }}"
pid_file: "{{ synapse_pid_file }}"

listeners:
  - port: {{ synapse_http_port }}
    tls: false
    type: http
    x_forwarded: true
    bind_addresses:
      - '{{ synapse_bind_address }}'
    resources:
      - names: [client, federation]
        compress: false

database:
{% if synapse_database_engine == 'postgresql' %}
  name: psycopg2
  args:
    user: "{{ synapse_database_user }}"
    password: "{{ synapse_database_password }}"
    database: "{{ synapse_database_name }}"
    host: "{{ synapse_database_host }}"
    port: {{ synapse_database_port }}
    cp_min: 5
    cp_max: 10
{% else %}
  name: sqlite3
  args:
    database: "{{ synapse_data_dir }}/homeserver.db"
{% endif %}

log_config: "{{ synapse_config_dir }}/log.yaml"

media_store_path: "{{ synapse_media_store_path }}"
max_upload_size: "{{ synapse_max_upload_size }}"

enable_registration: {{ synapse_enable_registration | lower }}
{% if synapse_registration_shared_secret | length > 0 %}
registration_shared_secret: "{{ synapse_registration_shared_secret }}"
{% endif %}

report_stats: {{ synapse_report_stats | lower }}

signing_key_path: "{{ synapse_signing_key_path }}"

trusted_key_servers:
{% for server in synapse_trusted_key_servers %}
  - server_name: "{{ server.server_name }}"
{% endfor %}

suppress_key_server_warning: true

rc_message:
  per_second: {{ synapse_rc_message.per_second }}
  burst_count: {{ synapse_rc_message.burst_count }}

url_preview_enabled: {{ synapse_url_preview_enabled | lower }}
{% if synapse_url_preview_enabled %}
url_preview_ip_range_blacklist:
{% for range in synapse_url_preview_ip_range_blacklist %}
  - '{{ range }}'
{% endfor %}
{% endif %}

{% if synapse_turn_uris | length > 0 %}
turn_uris:
{% for uri in synapse_turn_uris %}
  - "{{ uri }}"
{% endfor %}
turn_shared_secret: "{{ synapse_turn_shared_secret }}"
turn_user_lifetime: "{{ synapse_turn_user_lifetime }}"
{% endif %}

{% if synapse_extra_config | length > 0 %}
{{ synapse_extra_config | to_nice_yaml }}
{% endif %}
